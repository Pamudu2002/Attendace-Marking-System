DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-value-please
# Salt used when pseudonymising device IDs in exports
EXPORT_HASH_SALT=change-me
# Firebase service account JSON (single line) for FCM. Leave empty to log pushes instead of sending.
FIREBASE_SERVICE_ACCOUNT_JSON=
